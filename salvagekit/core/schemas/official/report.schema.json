{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "salvage:official/report.schema.json",
  "title": "Salvage report.json",
  "description": "Encodes kit/OUTPUT-CONTRACT.md (tool_version, files, totals) plus our one extra key, diagnostics, whose shape is in docs/output-format.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tool_version", "files", "totals", "diagnostics"],
  "properties": {
    "tool_version": {"type": "string", "minLength": 1},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "format", "status", "records", "damage"],
        "properties": {
          "file": {"type": "string", "minLength": 1},
          "format": {"type": "string", "minLength": 1},
          "status": {"$ref": "#/$defs/status"},
          "records": {"$ref": "#/$defs/count"},
          "damage": {"$ref": "#/$defs/count"}
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "partial", "unsupported", "unrecognized", "failed"],
      "properties": {
        "ok": {"$ref": "#/$defs/count"},
        "partial": {"$ref": "#/$defs/count"},
        "unsupported": {"$ref": "#/$defs/count"},
        "unrecognized": {"$ref": "#/$defs/count"},
        "failed": {"$ref": "#/$defs/count"}
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "files", "skipped", "warnings", "errors"],
      "properties": {
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["files", "skipped", "by_format"],
          "properties": {
            "files": {"$ref": "#/$defs/count"},
            "skipped": {"$ref": "#/$defs/count"},
            "by_format": {"type": "object", "additionalProperties": {"$ref": "#/$defs/count"}}
          }
        },
        "files": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input", "reason"],
            "properties": {
              "input": {"type": "string", "minLength": 1},
              "reason": {"type": "string"}
            }
          }
        },
        "warnings": {"$ref": "#/$defs/strings"},
        "errors": {"$ref": "#/$defs/strings"}
      }
    }
  },
  "$defs": {
    "status": {"enum": ["ok", "partial", "unsupported", "unrecognized", "failed"]},
    "count": {"type": "integer", "minimum": 0},
    "unit": {"type": "number", "minimum": 0, "maximum": 1},
    "percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "strings": {"type": "array", "items": {"type": "string"}},
    "by_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "consistent", "unverified", "lost"],
      "properties": {
        "verified": {"$ref": "#/$defs/count"},
        "consistent": {"$ref": "#/$defs/count"},
        "unverified": {"$ref": "#/$defs/count"},
        "lost": {"$ref": "#/$defs/count"}
      }
    },
    "damage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "kind", "reason", "lossy"],
      "properties": {
        "start": {"$ref": "#/$defs/count"},
        "end": {"$ref": "#/$defs/count"},
        "kind": {"enum": ["truncated", "crc_mismatch", "checksum_mismatch", "bad_length",
                          "unparsed_bytes", "count_mismatch", "invalid_value", "oob_pointer",
                          "index_missing", "header_checksum", "encrypted", "unknown_record"]},
        "reason": {"type": "string"},
        "lossy": {"type": "boolean"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes_total", "bytes_explained", "bytes_padding", "explained_pct",
                   "accounted_pct", "unexplained", "unexplained_truncated"],
      "properties": {
        "bytes_total": {"$ref": "#/$defs/count"},
        "bytes_explained": {"$ref": "#/$defs/count"},
        "bytes_padding": {"$ref": "#/$defs/count"},
        "explained_pct": {"$ref": "#/$defs/percent"},
        "accounted_pct": {"$ref": "#/$defs/percent"},
        "unexplained": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "array",
            "prefixItems": [{"$ref": "#/$defs/count"}, {"$ref": "#/$defs/count"}],
            "items": false,
            "minItems": 2
          }
        },
        "unexplained_truncated": {"type": "boolean"}
      }
    },
    "bytes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "sha256", "entropy", "entropy_sampled", "top_candidates"],
      "properties": {
        "size": {"$ref": "#/$defs/count"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "entropy": {"type": "number", "minimum": 0, "maximum": 8},
        "entropy_sampled": {"type": "boolean"},
        "top_candidates": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["format", "score"],
            "properties": {
              "format": {"type": "string"},
              "score": {"$ref": "#/$defs/unit"}
            }
          }
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "size", "sha256", "status", "format", "variant",
                   "confidence", "probe_score", "candidates", "attempts",
                   "records_by_status", "fields_by_status", "members", "damage",
                   "coverage", "bytes", "warnings", "errors"],
      "properties": {
        "input": {"type": "string", "minLength": 1},
        "output": {"type": ["string", "null"], "minLength": 1},
        "size": {"$ref": "#/$defs/count"},
        "sha256": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"},
                             {"type": "null"}]},
        "status": {"$ref": "#/$defs/status"},
        "format": {"type": "string", "minLength": 1},
        "variant": {"type": ["string", "null"], "minLength": 1},
        "confidence": {"$ref": "#/$defs/unit"},
        "probe_score": {"$ref": "#/$defs/unit"},
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["format", "score"],
            "properties": {
              "format": {"type": "string"},
              "score": {"$ref": "#/$defs/unit"},
              "error": {"type": "string"}
            }
          }
        },
        "attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["format", "outcome"],
            "properties": {
              "format": {"type": "string"},
              "outcome": {"type": "string",
                          "pattern": "^(ok|empty|unsupported|(invalid|error): [\\s\\S]*)$"}
            }
          }
        },
        "records_by_status": {"$ref": "#/$defs/by_status"},
        "fields_by_status": {"$ref": "#/$defs/by_status"},
        "members": {"$ref": "#/$defs/count"},
        "damage": {"type": "array", "items": {"$ref": "#/$defs/damage"}},
        "coverage": {"anyOf": [{"$ref": "#/$defs/coverage"}, {"type": "null"}]},
        "bytes": {"anyOf": [{"$ref": "#/$defs/bytes"}, {"type": "null"}]},
        "warnings": {"$ref": "#/$defs/strings"},
        "errors": {"$ref": "#/$defs/strings"}
      }
    }
  }
}
