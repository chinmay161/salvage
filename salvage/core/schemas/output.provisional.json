{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "salvage:output.provisional.json",
  "title": "Salvage per-file output (provisional-1)",
  "description": "Describes exactly the shape in docs/output-format.md. Replaced by the organizers' schema when it arrives.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "format", "variant", "confidence", "status",
               "records", "members", "damage", "meta", "warnings", "errors"],
  "properties": {
    "schema_version": {"const": "provisional-1"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size": {"$ref": "#/$defs/count"},
        "sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "format": {"type": "string", "minLength": 1},
    "variant": {"type": ["string", "null"], "minLength": 1},
    "confidence": {"$ref": "#/$defs/unit"},
    "status": {"enum": ["decoded", "partial", "unknown", "failed"]},
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "members": {"type": "array", "items": {"$ref": "#/$defs/member"}},
    "damage": {"type": "array", "items": {"$ref": "#/$defs/damage"}},
    "meta": {"type": "object"},
    "warnings": {"$ref": "#/$defs/strings"},
    "errors": {"$ref": "#/$defs/strings"}
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "unit": {"type": "number", "minimum": 0, "maximum": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "strings": {"type": "array", "items": {"type": "string"}},
    "trust": {"enum": ["verified", "consistent", "unverified", "lost"]},
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "offset", "length", "status", "evidence"],
      "properties": {
        "name": {"type": "string"},
        "value": true,
        "offset": {"$ref": "#/$defs/count"},
        "length": {"$ref": "#/$defs/count"},
        "status": {"$ref": "#/$defs/trust"},
        "evidence": {"type": "string"}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset", "status", "kind", "fields"],
      "properties": {
        "offset": {"$ref": "#/$defs/count"},
        "status": {"$ref": "#/$defs/trust"},
        "kind": {"type": "string"},
        "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}}
      }
    },
    "damage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "kind", "reason"],
      "properties": {
        "start": {"$ref": "#/$defs/count"},
        "end": {"$ref": "#/$defs/count"},
        "kind": {"enum": ["truncated", "checksum", "bounds", "unparsed", "other"]},
        "reason": {"type": "string"}
      }
    },
    "member": {
      "description": "A nested DecodeResult.to_dict() (archive member).",
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "confidence", "records", "members", "damage", "meta",
                   "warnings", "name"],
      "properties": {
        "format": {"type": "string"},
        "confidence": {"$ref": "#/$defs/unit"},
        "records": {"type": "array", "items": {"$ref": "#/$defs/record"}},
        "members": {"type": "array", "items": {"$ref": "#/$defs/member"}},
        "damage": {"type": "array", "items": {"$ref": "#/$defs/damage"}},
        "meta": {"type": "object"},
        "warnings": {"$ref": "#/$defs/strings"},
        "name": {"type": ["string", "null"]}
      }
    }
  }
}
